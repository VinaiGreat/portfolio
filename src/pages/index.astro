---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { siteConfig, homeContent } from "../config/content.ts";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteConfig.title}</title>
    <meta name="description" content={siteConfig.description} />

    <!-- Gestion du thème (light / dark) -->
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "dark";
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const initialTheme =
          savedTheme === "system"
            ? prefersDark
              ? "dark"
              : "light"
            : savedTheme;

        if (initialTheme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", (e) => {
            if (localStorage.getItem("theme") === "system") {
              if (e.matches) {
                document.documentElement.classList.add("dark");
              } else {
                document.documentElement.classList.remove("dark");
              }
            }
          });
      });
    </script>

    <style>
      body {
        margin: 0;
        font-family: system-ui, -apple-system, sans-serif;
      }

      /* Animation douce pour les “particles” du fond */
      @keyframes particlesDrift {
        0% {
          transform: translate3d(0, 0, 0);
        }
        50% {
          transform: translate3d(-12px, -8px, 0);
        }
        100% {
          transform: translate3d(0, 0, 0);
        }
      }

      @keyframes sandGlow {
        0% {
          --sand-color-1: #C49A6C45;
          --sand-color-2: #f0b47345;
        }
        50% {
          --sand-color-1: #D8B58A45;
          --sand-color-2: #F6C58B45;
        }
        100% {
          --sand-color-1: #C49A6C45;
          --sand-color-2: #f0b47345;
        }
      }

      .sand-animated {
        animation: sandGlow 18s ease-in-out infinite;
      }

      .dot-hexagon-light {
        background-image: radial-gradient(
            circle,
            #C49A6C45 1px,
            transparent 1px
          ),
          radial-gradient(circle, #f0b47345 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position: 0 0, 12px 20.78px;
      }

      .dot-hexagon-dark {
        background-image: radial-gradient(
            circle,
            #ffffff35 1px,
            transparent 1px
          ),
          radial-gradient(circle, #ffffff35 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position: 0 0, 12px 20.78px;
      }

      .particles-layer {
        animation: particlesDrift 18s ease-in-out infinite;
        will-change: transform;
      }

      /* Animation de l’image (loop + hover) */
      @keyframes floatLoop {
        0% {
          transform: translateY(0) scale(1);
        }
        50% {
          transform: translateY(-6px) scale(1.03);
        }
        100% {
          transform: translateY(0) scale(1);
        }
      }

      .float-interactive {
        transition: transform 300ms ease-out;
        animation: floatLoop 12s ease-in-out infinite;
        will-change: transform;
      }

      .float-interactive:hover {
        transform: translateY(-8px) scale(1.08);
      }
    </style>
  </head>

  <body
    class="min-h-screen flex flex-col bg-white dark:bg-neutral-900 transition-colors duration-300"
  >
    <div class="relative flex-grow flex flex-col">
      <!-- Fond global (hexagones + radial + halo + particles) -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div
          class="absolute inset-0 dot-hexagon-light dark:dot-hexagon-dark particles-layer"
        ></div>

        <div
          class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(255,255,255,0.5)_60%,rgba(255,255,255,0.9)_85%,white_100%)] dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(23,23,23,0.5)_60%,rgba(23,23,23,0.9)_85%,rgb(23,23,23)_100%)]"
        ></div>

        <div
          class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-[1200px] w-[1200px] rounded-full bg-neutral-400 opacity-10 blur-[100px] dark:bg-neutral-600 dark:opacity-15"
          style="max-height: 100vh; max-width: 100vw;"
        ></div>
      </div>

      <Navigation />

      <div class="relative flex flex-col flex-1 pt-4 min-h-0">
        <main class="flex-grow flex flex-col min-h-0">
          <div class="flex-1 flex items-center justify-center min-h-0">
            <div
              class="flex flex-row items-center justify-center w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 gap-12"
            >
              <!-- Colonne texte -->
              <div class="w-full md:w-[55%] text-left">
                <h1
                  class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-4xl"
                >
                  {homeContent.title}
                </h1>

                <p
                  class="mt-3 text-lg leading-7 text-neutral-600 dark:text-neutral-400"
                >
                  Infographiste et web designer autonome, titulaire d&apos;une
                  licence en
                  <a
                    href="https://www.onisep.fr/ressources/univers-metier/metiers/ui-designer-concepteur-conceptrice-d-interface-utilisateur"
                    title="Qu&apos;est-ce qu&apos;un CDUI ?"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-[#C49A6C] hover:text-[#A97F55] dark:text-[#E0B482] dark:hover:text-[#C49A6C] no-underline"
                  >
                    CDUI
                  </a>
                  , je crée des expériences visuelles cohérentes et des
                  interfaces soignées, tout en construisant progressivement mes
                  compétences en développement d&apos;applications.
                </p>

                <div class="flex flex-row gap-4 mt-4">
                  <a
                    class="group inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-neutral-900 rounded-lg hover:bg-neutral-800 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-200 transition-all duration-300 hover:scale-105 cursor-pointer"
                    href={homeContent.buttons.about.href}
                  >
                    {homeContent.buttons.about.text}
                    <svg
                      class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"
                      ></path>
                    </svg>
                  </a>
                </div>
              </div>

              <!-- Colonne image -->
              <div
                class="relative flex items-center justify-center bg-transparent overflow-hidden z-20 w-full md:w-[45%]"
              >
                <div
                  class="relative flex items-center justify-center overflow-hidden rounded-2xl shadow-lg hover:shadow-2xl transition-shadow duration-300"
                  style="width: min(700px, 45vw); height: min(700px, 70vh); max-width: 100%; max-height: 70vh;"
                >
                  {/* Image mode clair */}
                  <img
                    src={homeContent.images.light}
                    alt="Tech Background"
                    class="max-w-full max-h-full object-contain object-center opacity-100 dark:hidden float-interactive"
                  />

                  {/* Image mode sombre */}
                  <img
                    src={homeContent.images.dark}
                    alt="Tech Background Dark"
                    class="max-w-full max-h-full object-contain object-center opacity-100 hidden dark:block float-interactive"
                  />
                </div>
              </div>
            </div>
          </div>
        </main>

        <Footer />
      </div>
    </div>
  </body>
</html>